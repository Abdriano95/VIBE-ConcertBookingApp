<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DMA_AU24_LAB2_Group4.MAUI.Views.BookingDetailsPage"
             Title="Booking Details">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Label Text="{Binding Booking.ConcertTitle}" FontSize="20" FontAttributes="Bold" />
            <Label Text="{Binding Booking.PerformanceDate, StringFormat='Date: {0:dd MMM yyyy}'}" />
            <Label Text="{Binding Booking.Venue}" />
            <Label Text="{Binding Booking.City}" />
            <Label Text="{Binding Booking.Country}" />
            <Label Text="{Binding Booking.CustomerEmail}" FontSize="14" />
            <Button Text="Delete Booking" Command="{Binding DeleteBookingCommand}" BackgroundColor="Red" TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>