<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DMA_AU24_LAB2_Group4.MAUI.ViewModels"
             x:Class="DMA_AU24_LAB2_Group4.MAUI.Views.BookingDetailsPage"
             x:DataType="vm:BookingDetailsViewModel"
             Title="Booking Details">
    <Grid>
        <!-- Main Content -->
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource PageContent}">
                
                <!-- Booking Confirmation Card -->
                <Frame Style="{StaticResource ElevatedCard}">
                    <VerticalStackLayout Spacing="16">
                        
                        <!-- Success Header -->
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Frame BackgroundColor="{StaticResource Success}" 
                                   CornerRadius="30" 
                                   HeightRequest="60" 
                                   WidthRequest="60"
                                   Padding="0"
                                   HasShadow="False"
                                   HorizontalOptions="Center">
                                <Label Text="✓" 
                                       FontSize="32" 
                                       TextColor="{StaticResource White}"
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center" />
                            </Frame>
                            <Label Text="Booking Confirmed" 
                                   Style="{StaticResource SuccessLabel}" 
                                   FontSize="14"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        
                        <!-- Divider -->
                        <BoxView HeightRequest="1" 
                                 Color="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
                        
                        <!-- Concert Title -->
                        <Label Text="{Binding Booking.ConcertTitle}" 
                               Style="{StaticResource Headline}" 
                               FontSize="24"
                               HorizontalTextAlignment="Center" />
                        
                        <!-- Event Details -->
                        <VerticalStackLayout Spacing="12">
                            
                            <!-- Date & Time -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Frame Grid.Column="0" 
                                       BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                       CornerRadius="8" 
                                       Padding="10"
                                       HasShadow="False">
                                    <Label Text="🗓" FontSize="20" />
                                </Frame>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Date &amp; Time" Style="{StaticResource MutedLabel}" />
                                    <Label Text="{Binding Booking.PerformanceDate, StringFormat='{0:dddd, MMMM d, yyyy}'}" 
                                           Style="{StaticResource CardTitle}" 
                                           FontSize="16" />
                                </VerticalStackLayout>
                            </Grid>
                            
                            <!-- Venue -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Frame Grid.Column="0" 
                                       BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                       CornerRadius="8" 
                                       Padding="10"
                                       HasShadow="False">
                                    <Label Text="📍" FontSize="20" />
                                </Frame>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Venue" Style="{StaticResource MutedLabel}" />
                                    <Label Text="{Binding Booking.Venue}" 
                                           Style="{StaticResource CardTitle}" 
                                           FontSize="16" />
                                    <Label Style="{StaticResource CardSubtitle}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Booking.City}" />
                                                <Span Text=", " />
                                                <Span Text="{Binding Booking.Country}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                            
                            <!-- Customer Email -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Frame Grid.Column="0" 
                                       BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                       CornerRadius="8" 
                                       Padding="10"
                                       HasShadow="False">
                                    <Label Text="✉" FontSize="20" />
                                </Frame>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Confirmation sent to" Style="{StaticResource MutedLabel}" />
                                    <Label Text="{Binding Booking.CustomerEmail}" 
                                           Style="{StaticResource CardSubtitle}" />
                                </VerticalStackLayout>
                            </Grid>
                            
                        </VerticalStackLayout>
                        
                    </VerticalStackLayout>
                </Frame>
                
                <!-- Cancel Booking Button -->
                <Button Text="Cancel Booking" 
                        Command="{Binding DeleteBookingCommand}"
                        IsEnabled="{Binding IsDeleting, Converter={StaticResource InvertedBoolConverter}}"
                        Style="{StaticResource DangerButton}"
                        Margin="0,8,0,0" />
                
                <!-- Deleting Indicator -->
                <ActivityIndicator IsRunning="{Binding IsDeleting}"
                                   IsVisible="{Binding IsDeleting}"
                                   Color="{StaticResource Danger}"
                                   HeightRequest="30"
                                   WidthRequest="30"
                                   HorizontalOptions="Center"
                                   Margin="0,8,0,0" />
                        
            </VerticalStackLayout>
        </ScrollView>
        
        <!-- Loading Overlay -->
        <Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000"
              InputTransparent="False">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   Color="{StaticResource VibeCyan}"
                                   HeightRequest="50"
                                   WidthRequest="50" />
                <Label Text="Loading booking details..."
                       TextColor="White"
                       FontFamily="OpenSansSemibold"
                       FontSize="14"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
        
        <!-- Deleting Overlay -->
        <Grid IsVisible="{Binding IsDeleting}"
              BackgroundColor="#AA000000"
              InputTransparent="False">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsDeleting}"
                                   Color="{StaticResource Danger}"
                                   HeightRequest="50"
                                   WidthRequest="50" />
                <Label Text="Cancelling booking..."
                       TextColor="White"
                       FontFamily="OpenSansSemibold"
                       FontSize="14"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>