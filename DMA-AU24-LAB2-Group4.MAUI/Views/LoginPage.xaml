<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:DMA_AU24_LAB2_Group4.MAUI.ViewModels"
             x:Class="DMA_AU24_LAB2_Group4.MAUI.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Login"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#0D0D1A">

    <Grid>
        <!-- Background Video (Source set in code-behind) -->
        <toolkit:MediaElement x:Name="BackgroundVideo"
                              ShouldAutoPlay="True"
                              ShouldLoopPlayback="True"
                              ShouldMute="True"
                              ShouldShowPlaybackControls="False"
                              Aspect="AspectFill"
                              ZIndex="0" />
        
        <!-- Dark Gradient Overlay for readability -->
        <BoxView ZIndex="1">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#70000000" Offset="0.0" />
                    <GradientStop Color="#900D0D1A" Offset="0.6" />
                    <GradientStop Color="#DD0D0D1A" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
        
        <!-- Content Overlay -->
        <ScrollView ZIndex="2" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,40,24,24" 
                                 Spacing="0"
                                 VerticalOptions="Center">
                
                <!-- VIBE Logo (Large & Prominent) -->
                <Image Source="vibefull_removebg.png" 
                       HeightRequest="180" 
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       Margin="0,0,0,40" />
                
                <!-- Glassmorphism Login Card (Compact) -->
                <Border StrokeShape="RoundRectangle 20"
                        Stroke="#30FFFFFF"
                        StrokeThickness="1"
                        Padding="24"
                        Margin="0,0,0,20"
                        BackgroundColor="#401A1A2E">
                    <VerticalStackLayout Spacing="16">
                        
                        <!-- Welcome Header -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Welcome Back"
                                   TextColor="White"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="24"
                                   HorizontalOptions="Start" />
                            <Label Text="Sign in to continue"
                                   TextColor="#80FFFFFF"
                                   FontFamily="OpenSansRegular"
                                   FontSize="13"
                                   HorizontalOptions="Start" />
                        </VerticalStackLayout>
                        
                        <!-- Email Field -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Email" 
                                   TextColor="#BBFFFFFF"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="12" />
                            <Border StrokeShape="RoundRectangle 10"
                                    Stroke="#30FFFFFF"
                                    StrokeThickness="1"
                                    BackgroundColor="#25FFFFFF"
                                    Padding="4,0"
                                    HeightRequest="46">
                                <Entry Placeholder="you@example.com"
                                       PlaceholderColor="#55FFFFFF"
                                       Text="{Binding Email}" 
                                       Keyboard="Email"
                                       TextColor="White"
                                       BackgroundColor="Transparent"
                                       FontFamily="OpenSansRegular"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                        
                        <!-- Password Field -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Password" 
                                   TextColor="#BBFFFFFF"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="12" />
                            <Border StrokeShape="RoundRectangle 10"
                                    Stroke="#30FFFFFF"
                                    StrokeThickness="1"
                                    BackgroundColor="#25FFFFFF"
                                    Padding="4,0"
                                    HeightRequest="46">
                                <Entry Placeholder="Enter your password"
                                       PlaceholderColor="#55FFFFFF"
                                       Text="{Binding Password}" 
                                       IsPassword="True"
                                       TextColor="White"
                                       BackgroundColor="Transparent"
                                       FontFamily="OpenSansRegular"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                        
                        <!-- Sign In Button -->
                        <Button Text="Sign In"
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                TextColor="White"
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                CornerRadius="12"
                                HeightRequest="48"
                                Margin="0,4,0,0">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{StaticResource VibeCyan}" Offset="0.0" />
                                    <GradientStop Color="{StaticResource VibePurple}" Offset="1.0" />
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                        
                        <!-- Loading Indicator -->
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource VibeCyan}"
                                           HeightRequest="30"
                                           WidthRequest="30"
                                           HorizontalOptions="Center"
                                           Margin="0,8,0,0" />
                        
                    </VerticalStackLayout>
                </Border>
                
                <!-- Register Link -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                    <Label Text="Don't have an account?"
                           TextColor="#80FFFFFF"
                           FontFamily="OpenSansRegular"
                           FontSize="13" />
                    <Label Text="Create one"
                           TextColor="{StaticResource VibeCyan}"
                           FontFamily="OpenSansSemibold"
                           FontSize="13"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToRegisterCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
                
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>