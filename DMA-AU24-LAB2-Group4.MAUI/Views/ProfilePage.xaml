<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DMA_AU24_LAB2_Group4.MAUI.Views.ProfilePage"
             Title="Profile Page">
    <VerticalStackLayout>
        <Entry Placeholder="First Name" Text="{Binding Customer.FirstName}" />
        <Entry Placeholder="Last Name" Text="{Binding Customer.LastName}" />
        <Entry Placeholder="Email" Text="{Binding Customer.Email}" />
        <Entry Placeholder="Password" Text="{Binding Customer.Password}" IsPassword="True" />
        <Button Text="Update Profile" Command="{Binding UpdateProfileCommand}" />
        <Button Text="Logout" Command="{Binding LogoutCommand}" />
    </VerticalStackLayout>
</ContentPage>