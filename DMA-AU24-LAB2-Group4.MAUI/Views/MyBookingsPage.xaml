<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DMA_AU24_LAB2_Group4.MAUI.ViewModels"
             xmlns:behaviors="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="DMA_AU24_LAB2_Group4.MAUI.Views.MyBookingsPage"
             Title="My Bookings">
    <ContentPage.Behaviors>
        <!-- Triggers the loadcommand -->
        <behaviors:EventToCommandBehavior Command="{Binding LoadBookingsCommand}" EventName="Appearing" />
    </ContentPage.Behaviors>

    <CollectionView ItemsSource="{Binding Bookings}" SelectionMode="None">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Padding="10" Margin="5" BackgroundColor="LightGray" CornerRadius="5">
                    <Frame.GestureRecognizers>
                        <!-- Bind till navigeringskommandot i ViewModel -->
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MyBookingsViewModel}}, Path=NavigateToBookingDetailsCommand}" 
                                              CommandParameter="{Binding}" />
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout>
                        <Label Text="{Binding ConcertTitle}" FontSize="18" FontAttributes="Bold" />
                        <Label Text="{Binding PerformanceDate, StringFormat='Date: {0:dd MMM yyyy}'}" FontSize="14" />
                        <Label Text="{Binding Venue}" FontSize="14" />
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>