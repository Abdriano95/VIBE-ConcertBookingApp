<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DMA_AU24_LAB2_Group4.MAUI.ViewModels"
             x:Class="DMA_AU24_LAB2_Group4.MAUI.Views.PerformancePage"
             Title="Performance Details">

    <ContentPage.BindingContext>
        <vm:PerformanceViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20">
        <Label Text="Performance Details" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
        <Label Text="{Binding PerformanceDetails}" FontSize="16" />
    </VerticalStackLayout>
</ContentPage>