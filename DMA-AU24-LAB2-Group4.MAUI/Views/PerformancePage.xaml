<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DMA_AU24_LAB2_Group4.MAUI.ViewModels"
             xmlns:models="clr-namespace:DMA_AU24_LAB2_Group4.MAUI.Models"
             xmlns:behaviors="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="DMA_AU24_LAB2_Group4.MAUI.Views.PerformancePage"
             x:Name="thisPage"
             x:DataType="vm:PerformanceViewModel"
             Title="Available Performances">

    <ContentPage.Behaviors>
        <behaviors:EventToCommandBehavior EventName="Loaded" Command="{Binding LoadAvailablePerformancesAsyncCommand}" />
    </ContentPage.Behaviors>

    <Grid>
        <!-- Main Content -->
        <RefreshView IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadAvailablePerformancesAsyncCommand}"
                     RefreshColor="{StaticResource VibeCyan}">
            <VerticalStackLayout Style="{StaticResource PageContent}">
                <CollectionView ItemsSource="{Binding Performances}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12" Padding="40">
                            <Label Text="🎭" FontSize="48" HorizontalOptions="Center" />
                            <Label Text="No available performances" Style="{StaticResource CardTitle}" HorizontalOptions="Center" />
                            <Label Text="All shows may be sold out or already booked" 
                                   Style="{StaticResource CardSubtitle}" 
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Performance">
                            <Frame Style="{StaticResource PerformanceCard}">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="12" RowSpacing="6">
                                    <!-- Location Icon -->
                                    <Label Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                                           Text="📍" FontSize="28" 
                                           VerticalOptions="Start" />
                                    
                                    <!-- Venue -->
                                    <Label Grid.Row="0" Grid.Column="1" 
                                           Text="{Binding Venue}" 
                                           Style="{StaticResource CardTitle}" />
                                    
                                    <!-- City & Country -->
                                    <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <Label Text="{Binding City}" Style="{StaticResource CardSubtitle}" />
                                        <Label Text="•" Style="{StaticResource CardSubtitle}" />
                                        <Label Text="{Binding Country}" Style="{StaticResource CardSubtitle}" />
                                    </HorizontalStackLayout>
                                    
                                    <!-- Date & Time -->
                                    <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="6">
                                        <Label Text="🗓" FontSize="14" />
                                        <Label Text="{Binding PerformanceDateAndTime, StringFormat='{}{0:ddd, MMM d, yyyy • HH:mm}'}" 
                                               Style="{StaticResource AccentLabel}" />
                                    </HorizontalStackLayout>
                                    
                                    <!-- Book Button -->
                                    <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                            Text="Book Now"
                                            Style="{StaticResource AccentButton}"
                                            Margin="0,12,0,0"
                                            IsEnabled="{Binding Source={x:Reference thisPage}, Path=BindingContext.IsBooking, Converter={StaticResource InvertedBoolConverter}}"
                                            Clicked="OnBookNowClicked" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </RefreshView>
        
        <!-- Loading Overlay -->
        <Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000"
              InputTransparent="False">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   Color="{StaticResource VibeCyan}"
                                   HeightRequest="50"
                                   WidthRequest="50" />
                <Label Text="Loading performances..."
                       TextColor="White"
                       FontFamily="OpenSansSemibold"
                       FontSize="14"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
        
        <!-- Booking in Progress Overlay -->
        <Grid IsVisible="{Binding IsBooking}"
              BackgroundColor="#AA000000"
              InputTransparent="False">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBooking}"
                                   Color="{StaticResource VibeCyan}"
                                   HeightRequest="50"
                                   WidthRequest="50" />
                <Label Text="Creating your booking..."
                       TextColor="White"
                       FontFamily="OpenSansSemibold"
                       FontSize="14"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>