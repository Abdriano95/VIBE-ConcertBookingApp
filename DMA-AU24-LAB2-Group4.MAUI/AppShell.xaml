<?xml version="1.0" encoding="UTF-8" ?>
<Shell
x:Class="DMA_AU24_LAB2_Group4.MAUI.AppShell"
xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
xmlns:local="clr-namespace:DMA_AU24_LAB2_Group4.MAUI"
xmlns:views="clr-namespace:DMA_AU24_LAB2_Group4.MAUI.Views"
Title="VIBE"
Shell.FlyoutBehavior="Disabled">

    <ShellContent Route="LoginPage" ContentTemplate="{DataTemplate views:LoginPage}" />
    <ShellContent Route="RegisterPage" ContentTemplate="{DataTemplate views:RegisterPage}" />

    <TabBar>
        <!-- Concerts-->
        <Tab Title="Concerts" Icon="festival.png">
            <ShellContent Route="ConcertsPage" ContentTemplate="{DataTemplate views:ConcertsPage}" />
        </Tab>

        <!-- My bookings -->
        <Tab Title="My Bookings" Icon="tickets.png">
            <ShellContent Route="MyBookingsPage" ContentTemplate="{DataTemplate views:MyBookingsPage}" />
        </Tab>
        
        <!-- Profile -->
        <Tab Title="Profile" Icon="user.png">
            <ShellContent Route="ProfilePage" ContentTemplate="{DataTemplate views:ProfilePage}" />
        </Tab>

    </TabBar>

    <!-- PerformancePage route -->
    <ShellContent Route="PerformancePage" ContentTemplate="{DataTemplate views:PerformancePage}" />

    <!-- BookingDetailsPage route -->
    <ShellContent Route="BookingDetailsPage" ContentTemplate="{DataTemplate views:BookingDetailsPage}" />

</Shell>
